{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "firstread",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // One origin: auth cookies and magic links are issued for APP_URL only.
  "workers_dev": false,
  "routes": [{ "pattern": "product-gnome.com", "custom_domain": true }],
  // The SPA is served as static assets; only /api/* reaches the Worker first.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "firstread",
      "database_id": "9e802887-0bf0-4bc8-ba40-cf8fc4dea0b5",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "firstread-images" }],
  // Refunds generations whose client disconnected mid-flight.
  "triggers": { "crons": ["*/15 * * * *"] },
  // Non-secret settings. Secrets (BETTER_AUTH_SECRET, RESEND_API_KEY,
  // OPENAI_API_KEY, GEMINI_API_KEY, APPLE_*, STRIPE_SECRET_KEY,
  // STRIPE_WEBHOOK_SECRET) go in via `wrangler secret put` in production and
  // `.dev.vars` locally.
  "vars": {
    "APP_URL": "https://product-gnome.com",
    "MAIL_FROM": "FirstReader <prihlaseni@product-gnome.com>",
    "WELCOME_CREDITS": "5",
    "IMAGE_PROVIDER": "openai",
    "OPENAI_IMAGE_MODEL": "gpt-image-2",
    "GEMINI_IMAGE_MODEL": "gemini-3.1-flash-image",
    "IMAGE_QUALITY": "low",
    "CREDIT_COST_MAIN": "1",
    "CREDIT_COST_ICON": "1",
    // Buying credits stays hidden until both Stripe secrets are set.
    "PAYMENT_PROVIDER": "stripe"
  }
}
