# Copy to .dev.vars for local development (never commit .dev.vars).
APP_URL=http://localhost:5173
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Leave RESEND_API_KEY empty locally: magic links are printed to the console.
RESEND_API_KEY=
# mock | openai | gemini
IMAGE_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
# Sign in with Apple. Leave empty to hide the button. Apple does not accept
# localhost return URLs, so this only works on a real HTTPS domain.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
